# You are probably very excited to find the .env file in the repository - you security freak.
# But I have to disappoint you: there is nothing secret here.

PROJECT_NAME="stopsopatools"
FLAG="stopsopagithubio"


ENCODEMASK="/(^GOOGLE_DRIVE_|^N____ODE_API_|^(FB_PRIVATE_KEY|FIREBASE_API_KEY|AES256_KEY|GIPHY_API_KEY)<dollar>)/"


GITSTORAGE_CORE_REPOSITORY="git@github.com:stopsopa/gitstorage.git"
GITHUB_SOURCES_PREFIX="https://github.com/stopsopa/stopsopa.github.io"
# WARNING: instead of $ character place <dollar>
EXPOSE_EXTRA_ENV_VARIABLES="/(^PUBLIC_|^FIREBASE_|^LOCAL_HOSTS|^(PROJECT_NAME<dollar>|^NODE_API_PORT<dollar>|^GITHUB_SOURCES_PREFIX<dollar>|^GIPHY_API_KEY<dollar>|^PROD_|^GOOGLE_DRIVE_APPDATA_CLIENT_ID<dollar>)<dollar>)/"

GOOGLE_DRIVE_APPDATA_CLIENT_ID="securenv:AaQvW49ocGhB/hPJceeKOuybLSm02uG0/X1Z1+I48ilouB2pk6bvR9ic0Si4FD3mujLUcAI6HR6FaYrQKcU9qI12U97ULJzeoAAfVB0R6rYLbeD5n/VmDaAnb+3/LgSSfcJCx0a94LwEawxzCTMe0OWW91JF"

COMPOSE_PROJECT_NAME="stopsopatools"

PROD_SCHEMA="https"
PROD_HOSTNAME="stopsopa.github.io"
PROD_PORT="443"
# https://github.com/stopsopa/stopsopa.github.io/blob/master/pages/bash/rsync.sh

NODE_API_HOST="0.0.0.0"
NODE_API_PROTOCOL="https"
NODE_API_PORT=7898

NODE_SERVER_PROTOCOLS="https http"
# NODE_SERVER_PROTOCOLS="http"
# WARNING WARNING WARNING WARNING WARNING WARNING WARNING WARNING WARNING vvvvvv
# use this env var only together with NODE_SERVER_PROTOCOLS when launching server using both http and https
# when it comes to healthcheck.js and test runners just override for single execution NODE_API_PORT with value from NODE_API_PORT_HTTPS, like:
# NODE_API_PORT=4273 /bin/bash jasmine/test.sh --env .env -- --target docker
# or
# NODE_API_PORT="${NODE_API_PORT_HTTPS}" /bin/bash playwright.sh
# WARNING WARNING WARNING WARNING WARNING WARNING WARNING WARNING WARNING ^^^^^^
NODE_API_PORT_HTTPS=4339

LOCAL_HOSTS="stopsopa.github.io.com"
# must end with .com for example because otherwise /pages/services/google_drive_application_data_explorer/index.html
# will complain:
#           Invalid origin: Must end with a public top-level domain (such as .com or .org).


