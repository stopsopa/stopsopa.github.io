# used by transpile.sh (see TRANSPILATION.md), run:
#   /bin/bash transpile.sh transpile.ignore
#   /bin/bash transpile.sh transpile.ignore --watch

# for tsc.sh

tsc.ignore.ts
node_modules
bundle.ts
transpile.ts
transpile_prettier_pipe.ts
es.ts
bash/tee.ts
vitest.config.ts
scripts/template.ts
scripts/template.v2.ts
server-template.ts
bash/fs/relative.ts
bash/pnpm/minimumReleaseAge.ts
bash/exportsource.js

.github/injectServiceWorker_middleware.ts
.github/injectServiceWorker.ts

bash/fs/watch.js
bash/GLOSSARY.ts

pages/*
!pages/children/
pages/children/*
!pages/children/wotb/
pages/children/wotb/*
!pages/children/wotb/controls/
pages/children/wotb/controls/*
!pages/children/wotb/controls/antigravity/

# --- BEGIN: maps_apple_to_google convert.ts ---
# Transpile only pages/services/maps_apple_to_google/convert.ts -> convert.js (right next to it).
# 'pages/*' above ignores everything in pages/, and gitignore can't re-include a file
# whose parent directory is excluded - so each directory level is un-ignored, its other
# contents re-ignored, and finally the single file un-ignored (convert.test.ts stays ignored).
# These rules work only together and must stay below 'pages/*'.
!pages/services/
pages/services/*
!pages/services/maps_apple_to_google/
pages/services/maps_apple_to_google/*
!pages/services/maps_apple_to_google/convert.ts
# --- END: maps_apple_to_google convert.ts ---

# --- BEGIN: float-label-pattern index.ts ---
# Transpile only pages/html/float-label-pattern/index.ts -> index.js (right next to it).
# The same technique as in the block above: each directory level is un-ignored,
# its other contents re-ignored, and finally the single file un-ignored.
# These rules work only together and must stay below 'pages/*'.
!pages/html/
pages/html/*
!pages/html/float-label-pattern/
pages/html/float-label-pattern/*
!pages/html/float-label-pattern/index.ts
# --- END: float-label-pattern index.ts ---

transpile_prettier_pipe_old.ts
root.ts
es.ts
bash/socket/*

**/*.entry.ts
**/*.entry.js
**/*.entry.tsx

# and run
# time /bin/bash transpile.sh transpile.ignore
